rules_version = '2';
service cloud.firestore { match /databases/{d}/documents {
  function signed() { return request.auth != null; }
  function role() { return get(/databases/$(d)/documents/users/$(request.auth.uid)).data.role; }
  function hasRole(r) { return signed() && role() == r; }
  match /users/{uid} {
    allow read: if signed() && request.auth.uid == uid;
    allow create: if signed() && request.auth.uid == uid && request.resource.data.role == 'PATIENT';
    allow update, delete: if false;
  }
  match /patients/{id} {
    allow read: if hasRole('DOCTOR') || hasRole('COMPOUNDER') || (hasRole('PATIENT') && resource.data.uid == request.auth.uid);
    allow create, update: if hasRole('COMPOUNDER');
    allow delete: if false;
  }
  match /appointments/{id} {
    allow read: if hasRole('DOCTOR') || hasRole('COMPOUNDER') || (hasRole('PATIENT') && resource.data.patientUid == request.auth.uid);
    allow create, update: if hasRole('COMPOUNDER');
    allow delete: if false;
  }
  match /counters/{id} { allow read, write: if hasRole('COMPOUNDER'); }
  match /notifications/{id} {
    allow create: if hasRole('COMPOUNDER') || hasRole('DOCTOR');
    allow read, update, delete: if false;
  }
  match /auditLogs/{id} {
    allow create: if signed() && request.resource.data.uid == request.auth.uid;
    allow read: if hasRole('DOCTOR');
    allow update, delete: if false;
  }
}}
